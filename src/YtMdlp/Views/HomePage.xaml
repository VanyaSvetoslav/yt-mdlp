<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="YtMdlp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:YtMdlp.ViewModels"
    xmlns:models="using:YtMdlp.Models"
    mc:Ignorable="d">

    <Page.DataContext>
        <vm:HomeViewModel />
    </Page.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="4,0,4,16" MaxWidth="900" HorizontalAlignment="Stretch">

            <TextBlock Text="Download a YouTube video" Style="{StaticResource TitleTextBlockStyle}"/>

            <TextBox
                x:Name="UrlBox"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Paste YouTube link…"
                Header="YouTube URL"
                FontSize="16"
                Padding="12"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Command="{x:Bind ViewModel.FetchInfoCommand}"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="14"/>
                        <TextBlock Text="Fetch Info"/>
                    </StackPanel>
                </Button>
                <ProgressRing
                    Width="20" Height="20"
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusyVisibility, Mode=OneWay}"/>
            </StackPanel>

            <!-- Fetched info card -->
            <Border
                Visibility="{x:Bind ViewModel.FetchedInfoVisibility, Mode=OneWay}"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image
                        Grid.Column="0"
                        Source="{x:Bind ViewModel.FetchedInfo.ThumbnailUrl, Mode=OneWay, FallbackValue=''}"
                        Stretch="UniformToFill"
                        Height="124"/>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind ViewModel.FetchedInfo.Title, Mode=OneWay, FallbackValue=''}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            TextWrapping="Wrap"
                            MaxLines="2"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE125;" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.FetchedInfo.Channel, Mode=OneWay, FallbackValue=''}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE916;" FontSize="14"/>
                            <TextBlock Text="{x:Bind ViewModel.FetchedInfo.DurationDisplay, Mode=OneWay, FallbackValue=''}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Format / quality -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    Header="Format"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Formats}"
                    SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"/>

                <ComboBox
                    Grid.Column="1"
                    Header="Quality"
                    HorizontalAlignment="Stretch"
                    Visibility="{x:Bind ViewModel.QualityVisibility, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.Qualities}"
                    SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}"/>
            </Grid>

            <!-- Output folder -->
            <StackPanel Spacing="8">
                <TextBlock Text="Output folder" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>
                    <Button
                        Grid.Column="1"
                        Content="Choose…"
                        Command="{x:Bind ViewModel.PickOutputFolderCommand}"/>
                </Grid>
            </StackPanel>

            <!-- Download / cancel -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Content="Download"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.DownloadCommand}"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    MinWidth="160"/>
                <Button
                    Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.IsBusyVisibility, Mode=OneWay}"/>
            </StackPanel>

            <!-- Progress -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsBusyVisibility, Mode=OneWay}">
                <ProgressBar
                    IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
                    Maximum="100"/>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"/>
            </StackPanel>

            <!-- Error / success -->
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Severity="Error"
                Title="Error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, FallbackValue=''}"
                IsClosable="True"/>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasSuccess, Mode=OneWay}"
                Severity="Success"
                Title="Done"
                Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay, FallbackValue=''}"
                IsClosable="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
