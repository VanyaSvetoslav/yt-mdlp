<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>YtMdlp</RootNamespace>
    <AssemblyName>YtMdlp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- WinUI 3 -->
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon />
    <StartupObject />
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.WindowsAppSDK transitively pulls in the matching
         Microsoft.Windows.SDK.BuildTools, so we don't pin it explicitly. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.251014001" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled binaries. yt-dlp.exe + the BtbN ffmpeg shared build (ffmpeg.exe,
         ffprobe.exe, avcodec-*.dll, avformat-*.dll, avfilter-*.dll, etc.) live
         here. They are NOT committed to git - run scripts/bootstrap.ps1 once
         before building to populate this folder. We use a glob (rather than
         per-file <None Update> entries) so that any DLLs or license files the
         bootstrap script drops in are also copied to the publish output. -->
    <Content Include="Assets\bin\**\*"
             Exclude="Assets\bin\.gitkeep">
      <Link>Assets\bin\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="Assets\bin\.gitkeep">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
